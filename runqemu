#!/bin/bash

# doc/develop/devicetree/dt_qemu.rst
# qemu-system-aarch64 -machine virt -machine dumpdtb=qemu.dtb
# cat  <(dtc -I dtb qemu.dtb) <(dtc -I dtb u-boot.dtb | grep -v /dts-v1/) | dtc - -o merged.dtb
# u-boot dtb is in dts/dt.dtb
# add -dtb merged.dtb to qemu command line
#
. .config
: "${CONFIG_ARCH:=$(uname -m)}"
: "${CONFIG_UBOOT:=/usr/lib/u-boot/qemu-$CONFIG_ARCH/u-boot.bin}"
: "${disk:=img}"
args=(  -m 4G -smp 4 \
	-serial mon:stdio \
	-nic "user,model=virtio-net-pci" \
	-drive "if=virtio,file=$disk,format=raw,media=disk")

if [ "$CONFIG_ARCH" = aarch64 ]; then
	args+=(-machine virt -cpu cortex-a57 \
	      -device virtio-serial-device \
	      -device "virtconsole,chardev=con" -chardev "vc,id=con" \
	      -device virtio-rng-pci \
	      -device "qemu-xhci,id=xhci")
	args+=(-nographic)
fi
args+=(-bios "$CONFIG_UBOOT")

qemu-system-"$CONFIG_ARCH" "${args[@]}"
