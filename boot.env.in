setenv xtrace yes
#printenv
#setenv bootargs console=ttyAMA0,115200 rw panic=3
load ${devtype} ${devnum}:${distro_bootpart} ${loadaddr} @FIT@ || panic
# FIXME: needs to go through configuration
iminfo
fdt addr ${loadaddr}
fdt get value image_bootargs /configurations/${board} cmdline
setenv bootargs ${image_bootargs} ${extra_bootargs}
if test "${board}" = "qemu-arm"; then
	echo "QEMU detected, using qemu DT at ${fdt_addr}"
	fdt addr ${fdt_addr}
	bootm ${loadaddr}#${board} ${loadaddr}#${board} ${fdt_addr}
else
	bootm ${loadaddr}#${board}
fi
