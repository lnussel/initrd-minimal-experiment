#!/bin/bash
set -e
shopt -s nullglob

: "${ARCH:=$(uname -m)}"
case "$ARCH" in
	x86_64) efiarch=x64 ;;
	aarch64) efiarch=aa64 ;;
	*) echo "unknown arch $ARCH" >&2; exit 1 ;;
esac
: "${kv:=$(uname -r)}"
: "${pfx:=/usr/lib/systemd}"
: "${sdboot:=$pfx/boot/efi/systemd-boot$efiarch.efi}"
: "${sdstub:=$pfx/boot/efi/linux$efiarch.efi.stub}"
: "${cmdline:=verbose console=ttyS0 console=tty}"
# "${keyfile:=private.pem}"

for i in vmlinuz Image; do
	kernel="/lib/modules/$kv/$i"
	[ -e "$kernel" ] || continue
	break
done
if ! [ -e "$kernel" ]; then
	echo "$kernel not found. Set \$kv to one of the following versions:"
	echo /lib/modules/*/{vmlinz,Image}
	exit 1
fi

rm -rf efi

read -r token < /etc/machine-id

mkdir -p efi/EFI/BOOT
mkdir -p efi/EFI/Linux

dst=efi/EFI/Linux/"$token-$kv.efi"
cp "$sdboot" efi/EFI/BOOT/BOOT${efiarch^^}.EFI

/usr/lib/systemd/ukify build \
	--stub="$sdstub" \
	--linux="$kernel" \
	--initrd=initrd \
	--cmdline="${cmdline}" \
	--splash=splash.bmp \
	--output "$dst"

mkdir -p "$dst.extra.d/modules"
cd "$dst.extra.d"

	declare -A mods
	todo=(btrfs vfat overlay efivarfs virtio_blk qemu_fw_cfg)
	i=0
	while [ "$i" -lt "${#todo[@]}" ]; do
		module="${todo[$i]}"
		: $((i++))
		[ -z "${mods[$module]}" ] || continue
		fn="$(/usr/sbin/modinfo -k "$kv" -F filename "$module")"
		[ "$fn" != "(builtin)" ] || continue
		mods["$module"]="$fn"
		IFS=, read -r -a d < <(/usr/sbin/modinfo -k "$kv" -F depends "$module" || :)
		for m in "${d[@]}"; do
			[ -z "${mods[$m]}" ] || continue
			todo+=("$m")
		done
	done
	for m in "${!mods[@]}"; do
		fn="${mods[$m]}"
		dfn="modules/${fn##*/}"
		case "$fn" in
			*.zst) zstdcat "$fn" > "${dfn%.zst}" ;;
			*.ko) cp "$fn" "$dfn" ;;
			*) echo "unknown file format" >&2 ;;
		esac
	done

cd -

: > efi-stamp
